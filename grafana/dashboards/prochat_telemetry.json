{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "title": "ProChat Multi-Engine — Observabilidad & Consumo de Tokens",
  "tags": ["prochat", "telemetry", "tokens", "costs"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "title": "Costo Financiero Estimado Acumulado (USD)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(chatbot_estimated_cost_usd_total)",
          "legendFormat": "Costo Total USD"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 50 }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "Consumo de Tokens por Inquilino (Tenant)",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(chatbot_tokens_consumed_total[5m])) by (tenant_id, token_type)",
          "legendFormat": "{{tenant_id}} - {{token_type}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Latencia de Respuestas por Motor (Segundos)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 6 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(chatbot_execution_duration_seconds_bucket[5m])) by (le, chat_type))",
          "legendFormat": "p95 {{chat_type}}"
        }
      ]
    }
  ]
}
