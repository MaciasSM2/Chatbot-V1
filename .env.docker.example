# CONFIGURACIÓN GENERAL PARA EL ENTORNO DOCKER DE CHATBOT

# Configuración del Backend Express
PORT=3000
DATABASE_URL=postgresql://postgres:postgrespassword@postgres:5432/chatbot_db
REDIS_HOST=redis
REDIS_PORT=6379

# Credenciales y Configuración de la API Cloud de WhatsApp (Meta)
# Reemplaza con tus valores reales en producción
WA_PHONE_NUMBER_ID=tu_numero_id
WA_ACCESS_TOKEN=tu_token_de_acceso
VERIFY_TOKEN=tu_token_de_verificacion_webhook
APP_SECRET=tu_app_secret_de_meta

# URL del Frontend (Dashboard) para habilitar CORS
FRONTEND_URL=http://localhost:3001

# Configuración del Dashboard Next.js (URL de la API del Backend desde el cliente)
NEXT_PUBLIC_API_URL=http://localhost:3000/api
